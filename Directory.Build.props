<Project>
  <!-- Settings shared by every project in this repository. -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    A warning fails the build, and the code-style rules (IDE...) that .editorconfig sets to warning are part of the
    build. BannedSymbols.txt in each project lists the APIs that may not be called, each with what to use instead.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- On by default only for net5.0 and later; set here so the netstandard2.0 and net48 builds are checked too. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- A new security advisory on a package stays a warning: it must be seen, but not stop every build at once. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\BannedSymbols.txt" Condition="Exists('$(MSBuildProjectDirectory)\BannedSymbols.txt')" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Spatial Eye B.V., OrchestrationEngines contributors</Authors>
    <Product>OrchestrationEngines</Product>
  </PropertyGroup>

  <!--
    Packaging settings (see docs/Releasing.md). Packing fails until the repository URL is set; the check is
    in Directory.Build.targets.
  -->
  <PropertyGroup>
    <!-- SPDX licence expression; the text is in LICENSE. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Spatial Eye B.V.</Copyright>
    <!-- The repository's final home; the package links to it and SourceLink points debuggers at it. -->
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>

  <!-- Builds on a CI server are reproducible (normalised paths for SourceLink and symbols). -->
  <PropertyGroup Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
