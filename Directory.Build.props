<Project>
  <!-- Settings shared by every project in this repository. -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>OrchestrationEngines contributors</Authors>
    <Product>OrchestrationEngines</Product>
  </PropertyGroup>

  <!--
    Packaging settings (see docs/Releasing.md). Packing fails while a decided setting is missing; the check
    is in Directory.Build.targets.
  -->
  <PropertyGroup>
    <!-- SPDX licence expression; the text is in LICENSE. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Spatial Eye</Copyright>
    <!-- The repository's final home; the package links to it and SourceLink points debuggers at it. -->
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>

  <!-- Builds on a CI server are reproducible (normalised paths for SourceLink and symbols). -->
  <PropertyGroup Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
