<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 covers .NET Framework 4.8 and older .NET versions; net10.0 gets the modern runtime APIs. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>OrchestrationEngines</RootNamespace>
    <AssemblyName>OrchestrationEngines</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OrchestrationEngines</PackageId>
    <Description>Dependency-aware orchestration of interdependent runtime engines: ordered startup, health propagation and controlled restarts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Stateless" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrchestrationEngines.Tests" />
  </ItemGroup>

</Project>
